DATABASE_PATH=../database/ecommerce.sqlite
CORS_ORIGIN=http://localhost:5173

# Anthropic API configuration (primary LLM per architecture docs)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# NVIDIA Nemotron / OpenAI-compatible backup configuration
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Offline deterministic demo mode (no API key required)
OFFLINE_DEMO_MODE=false

MAX_TOOL_ITERATIONS=8
TOOL_TIMEOUT_SECONDS=30
