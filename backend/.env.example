DATABASE_PATH=../database/ecommerce.sqlite
CORS_ORIGIN=http://localhost:5173

# Multi-database adapter configuration (sqlite | postgresql | mysql | mongodb)
DB_TYPE=sqlite
# DATABASE_URL=postgresql://user:pass@localhost:5432/dataflow

# Anthropic API configuration (primary LLM per architecture docs)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# NVIDIA Nemotron / OpenAI-compatible backup configuration
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Offline deterministic demo mode (no API key required)
OFFLINE_DEMO_MODE=false

MAX_TOOL_ITERATIONS=8
TOOL_TIMEOUT_SECONDS=30

# Session storage backend (memory | sqlite)
SESSION_BACKEND=memory
SESSION_DB_PATH=../database/sessions.sqlite
SESSION_TTL_DAYS=30

# Authentication (disabled by default for hackathon demo)
AUTH_ENABLED=false
API_KEY=
AUTH_TOKEN_SECRET=change-me-in-production
AUTH_DEMO_USERNAME=dataflow
AUTH_DEMO_PASSWORD=dataflow
AUTH_TOKEN_EXPIRE_HOURS=24

# Rate limiting (0 = disabled)
RATE_LIMIT_RPM=0
