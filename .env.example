# Anthropic API configuration
# Leave as mock_key_for_dev to run the deterministic offline demo loop.
ANTHROPIC_API_KEY=mock_key_for_dev
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Database path inside the backend container
DATABASE_PATH=/app/database/ecommerce.sqlite

# CORS origins for local development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
